# in app/teams_data.py are used (the app works fully offline).
#
# The client accepts either a flat {"BRA": 2021, ...} JSON map or a list of
# {"id"|"code"|"team": ..., "elo"|"rating": ...} objects, with an optional
# {"response": [...]} wrapper (API-Football style).
ELO_API_URL=
